# --- Jev / TypeSafe (required) ---------------------------------------------
TYPESAFE_API_KEY=
# Pin a concrete version in production; thresholds are calibrated per version.
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MAX_RETRIES=1

# --- Decision policy --------------------------------------------------------
# Action thresholds from `python -m eval.calibrate` (not a probability calibration).
# Whether is_fraud.noul matches observed fraud rates: `python -m eval.calibration`.
POLICY_T_LOW=0.20
POLICY_T_HIGH=0.80
# Spread risk or pattern distributions below this go to review. Not a decline gate.
POLICY_EVIDENCE_MIN=0.50
# Verified OTP is overridden to DECLINE if the agent's fraud_prob >= this.
POLICY_AGENT_DECLINE_PROB=0.90

# --- OTP step-up ------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_CODE_LENGTH=6
# Dev mode returns the code in the API response and logs it (mock SMS). Set false in prod.
OTP_DEV_MODE=true

# --- Investigation agent (optional LLM tier) --------------------------------
# init_chat_model strings, provider-agnostic. Install the matching extra:
#   uv pip install -e ".[openai]"    or    ".[anthropic]"    or    ".[google]"
#   e.g. LLM_FAST=openai:gpt-4o-mini | anthropic:claude-3-5-haiku-latest | google_genai:gemini-2.5-flash
# Leave LLM_FAST empty to disable the agent tier entirely.
AGENT_ENABLED=true
LLM_FAST=
LLM_POWERFUL=
AGENT_TOOL_RISK_THRESHOLD=0.30
AGENT_MAX_STEPS=12
# Provider keys as needed by the models above, e.g.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO
# Docker / Render / Railway: FastAPI serves frontend/dist from the same process.
# SERVE_FRONTEND=true
# FRONTEND_DIST=/app/frontend/dist
